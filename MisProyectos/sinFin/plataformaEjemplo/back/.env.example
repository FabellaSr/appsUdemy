# --- App
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# --- MongoDB (auth, users, sessions)
MONGO_URI=mongodb://mongo:27017/provider_auth

# --- SQL Server (providers, collections, payments, logs)
SQL_HOST=sqlserver
SQL_PORT=1433
SQL_USER=sa
SQL_PASSWORD=Your_strong_Passw0rd
SQL_DATABASE=provider_db
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Image storage adapter: cloudinary | s3
STORAGE_PROVIDER=cloudinary

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
