NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tu-frontend.com

# PostgreSQL (Railway / Supabase)
# Pegar la connection string completa del dashboard, o completar campo a campo:
DB_TYPE=postgres
DB_SSL=true
SQL_HOST=
SQL_PORT=5432
SQL_USER=
